{
  "manifest_version": 3,
  "name": "Vocab Tabs",
  "version": "1.0.0",
  "description": "Learn new words every time you open a new tab.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "host_permissions": [
    "https://api.artic.edu/*",
    "https://www.artic.edu/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
